server {
  listen 80 default_server;
  server_name templates.localhost;

  location / {
    proxy_pass http://host.docker.internal:$EMAIL_PREVIEW_UPSTREAM_PORT;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }
}

server {
  listen 80;
  server_name localhost;

  location = /api {
    return 308 /api/v1/health;
  }

  location = /admin/jobs {
    return 308 /admin/jobs/$is_args$args;
  }

  location ^~ /api/ {
    proxy_pass http://host.docker.internal:$API_UPSTREAM_PORT;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ^~ /admin/jobs/ {
    proxy_pass http://host.docker.internal:$API_UPSTREAM_PORT;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /trpc/bugReports.submit {
    client_max_body_size 16m;
    proxy_pass http://host.docker.internal:$API_UPSTREAM_PORT;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ^~ /trpc/ {
    proxy_pass http://host.docker.internal:$API_UPSTREAM_PORT;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    proxy_pass http://host.docker.internal:$APP_UPSTREAM_PORT;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }
}
