{
  "name": "@parcelis/api",
  "version": "0.3.0",
  "private": true,
  "exports": {
    "./router": {
      "types": "./src/router/app.router.ts",
      "default": "./src/router/app.router.ts"
    }
  },
  "scripts": {
    "dev": "node ../../scripts/run-with-open-port.mjs API_PORT 40010 nest start --watch",
    "dev:fixed": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "generate:openapi": "tsx ./scripts/generate-openapi.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@parcelis/db": "workspace:*",
    "@parcelis/schemas": "workspace:*",
    "@trpc/server": "^11.18.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "trpc-to-openapi": "^3.3.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@parcelis/config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "tsx": "^4.23.1",
    "typescript": "^5.6.2"
  }
}
