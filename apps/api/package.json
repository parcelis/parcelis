{
  "name": "@parcelis/api",
  "version": "0.4.1",
  "private": true,
  "exports": {
    "./router": {
      "types": "./src/router/app.router.ts",
      "default": "./src/router/app.router.ts"
    }
  },
  "scripts": {
    "dev": "node ./scripts/dev.mjs --open-port",
    "dev:fixed": "node ./scripts/dev.mjs",
    "build": "next build",
    "start": "node ./scripts/start.mjs",
    "test": "tsx --test \"src/tests/**/*.test.ts\"",
    "generate:openapi": "tsx ./scripts/generate-openapi.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-presigned-post": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@bull-board/api": "^9.10.1",
    "@bull-board/hono": "^9.10.4",
    "@fontsource/inter": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@parcelis/db": "workspace:*",
    "@parcelis/email": "workspace:*",
    "@parcelis/jobs": "workspace:*",
    "@parcelis/schemas": "workspace:*",
    "@react-pdf/renderer": "^4.6.0",
    "@trpc/server": "^11.18.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.9",
    "dotenv": "^17.4.2",
    "hono": "^4.13.13",
    "next": "^16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.3.0",
    "trpc-to-openapi": "^3.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@parcelis/config": "workspace:*",
    "@types/node": "24.19.1",
    "tsx": "^4.23.12",
    "typescript": "6.0.3"
  }
}
