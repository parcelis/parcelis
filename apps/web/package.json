{
  "name": "@parcelis/web",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/run-with-open-port.mjs PORT 30000 next dev --turbo --hostname 0.0.0.0 --port {PORT}",
    "dev:fixed": "next dev --turbo --hostname 0.0.0.0 --port ${PORT:-30000}",
    "build": "next build",
    "start": "node ../../scripts/run-with-open-port.mjs PORT 30000 next start --port {PORT}",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@parcelis/api": "workspace:*",
    "@parcelis/schemas": "workspace:*",
    "@parcelis/ui": "workspace:*",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.32.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@parcelis/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.7.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.2"
  }
}
