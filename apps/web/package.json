{
  "name": "@parcelis/web",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/run-with-open-port.mjs PORT 43100 next dev --turbo --hostname 0.0.0.0 --port {PORT}",
    "dev:fixed": "next dev --turbo --hostname 0.0.0.0 --port ${PORT:-43100}",
    "build": "next build",
    "start": "node ../../scripts/run-with-open-port.mjs PORT 43100 next start --port {PORT}",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@parcelis/api": "workspace:*",
    "@parcelis/schemas": "workspace:*",
    "@parcelis/ui": "workspace:*",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.59.16",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "dotenv": "^16.6.1",
    "lucide-react": "^1.28.0",
    "next": "^16.2.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@parcelis/config": "workspace:*",
    "@types/node": "^22.7.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}
