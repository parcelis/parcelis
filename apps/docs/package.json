{
  "name": "@parcelis/docs",
  "version": "0.2.5",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/run-with-open-port.mjs PORT 40000 docusaurus start --host 0.0.0.0 --port {PORT}",
    "dev:fixed": "docusaurus start --host 0.0.0.0 --port ${PORT:-40000}",
    "build": "docusaurus build",
    "generate:api": "docusaurus clean-api-docs all && docusaurus gen-api-docs all",
    "start": "node ../../scripts/run-with-open-port.mjs PORT 40000 docusaurus serve --host 0.0.0.0 --port {PORT}",
    "serve": "docusaurus serve --host 0.0.0.0 --port ${PORT:-40000}",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "docusaurus-plugin-copy-page-button": "^0.8.4",
    "docusaurus-plugin-openapi-docs": "^5.1.2",
    "docusaurus-plugin-sass": "^0.2.6",
    "docusaurus-theme-openapi-docs": "^5.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sass": "^1.101.7"
  },
  "devDependencies": {
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "^22.7.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "^5.6.2"
  }
}
