{
  "name": "@parcelis/email",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:fixed": "email dev --dir src/templates --port ${EMAIL_PREVIEW_PORT:-30001}",
    "email:preview": "email dev --dir src/templates",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "nodemailer": "^9.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.3"
  },
  "devDependencies": {
    "@parcelis/config": "workspace:*",
    "@react-email/ui": "^6.9.3",
    "@types/node": "24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  }
}
