{
  "name": "@parcelis/db",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "node ../../scripts/prisma-with-env.mjs generate",
    "db:migrate": "node ../../scripts/prisma-with-env.mjs migrate dev",
    "db:seed": "node ../../scripts/prisma-with-env.mjs db seed",
    "db:studio": "node ../../scripts/prisma-with-env.mjs studio",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@parcelis/config": "workspace:*",
    "@types/pg": "^8.16.0",
    "prisma": "^7.9.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
