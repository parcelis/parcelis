generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyStatus {
  active
  maintenance
  leasing
  archived
}

enum LeaseStatus {
  draft
  active
  notice
  ended
}

enum InvoiceStatus {
  open
  overdue
  paid
  void
}

enum MaintenanceTicketStatus {
  new
  in_progress
  pending
  scheduled
  resolved
  closed
  canceled
}

enum MaintenanceTicketPriority {
  low
  medium
  high
  urgent
}

enum MaintenanceRequesterType {
  tenant
  landlord
}

enum ActivitySubjectType {
  maintenance_ticket
  tenant
  property
  invoice
}

enum UnitType {
  residential
  commercial
}

enum TenantAccountStatus {
  activated
  invitation_pending
  disabled
}

enum TenantInsuranceStatus {
  active
  expired
  not_on_file
}

enum UserRole {
  administrator
  member
}

enum UserAccountStatus {
  active
  disabled
}

enum OrganizationMemberRole {
  owner
  administrator
  member
}

model Organization {
  id                    Int                      @id @default(autoincrement())
  name                  String
  slug                  String                   @unique
  memberships           OrganizationMembership[]
  properties            Property[]
  tenants               Tenant[]
  landlords             Landlord[]
  tags                  Tag[]
  utilityTypes          UtilityType[]
  amenityTypes          AmenityType[]
  maintenanceCategories MaintenanceCategory[]
  leases                Lease[]
  invoices              Invoice[]
  maintenanceTickets    MaintenanceTicket[]
  activityEvents        ActivityEvent[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
}

model OrganizationMembership {
  id             Int                    @id @default(autoincrement())
  userId         Int
  organizationId Int
  role           OrganizationMemberRole @default(member)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model User {
  id            Int               @id @default(autoincrement())
  name          String            @default("User")
  email         String            @unique
  phone         String?
  role          UserRole          @default(member)
  accountStatus UserAccountStatus @default(active)
  passwordHash  String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sessions      Session[]
  organizationMemberships OrganizationMembership[]
}

model Session {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  lastSeenAt DateTime @default(now())
  activeOrganizationId Int?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Property {
  id                 Int                 @id @default(autoincrement())
  organizationId     Int
  name               String
  line1              String
  line2              String?
  city               String
  region             String
  postalCode         String
  propertyType       String              @default("Apartment")
  imageObjectKey     String?
  tags               Tag[]
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  contactAddress     String?
  legacyNotes        String?             @map("notes")
  legacyNoteId       Int?
  legacyNote         Note?               @relation("PropertyLegacyNote", fields: [id, legacyNoteId], references: [propertyId, id], onDelete: SetNull)
  unitCount          Int
  occupiedUnits      Int                 @default(0)
  status             PropertyStatus      @default(active)
  units              Unit[]
  leases             Lease[]
  invoices           Invoice[]
  notes              Note[]
  maintenanceTickets MaintenanceTicket[]
  activityEvents     ActivityEvent[]
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([id, legacyNoteId])
  @@index([organizationId])
}

model Tag {
  id         Int        @id @default(autoincrement())
  organizationId Int
  label      String     @unique
  sortOrder  Int        @default(0)
  properties Property[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model Unit {
  id                 Int                     @id @default(autoincrement())
  propertyId         Int
  name               String
  marketRateCents    Int
  unitType           UnitType                @default(residential)
  bedrooms           Int?
  bathrooms          Decimal?                @db.Decimal(4, 1)
  squareFeet         Int?
  property           Property                @relation(fields: [propertyId], references: [id])
  utilities          UnitUtility[]
  amenities          UnitAmenity[]
  notes              Note[]
  maintenanceTickets MaintenanceTicketUnit[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([propertyId, name])
  @@index([propertyId])
}

model UtilityType {
  id        Int           @id @default(autoincrement())
  organizationId Int
  label     String        @unique
  sortOrder Int           @default(0)
  units     UnitUtility[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model AmenityType {
  id        Int           @id @default(autoincrement())
  organizationId Int
  label     String        @unique
  sortOrder Int           @default(0)
  units     UnitAmenity[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model UnitUtility {
  unitId   Int
  optionId Int
  unit     Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  option   UtilityType @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([unitId, optionId])
  @@index([optionId])
}

model UnitAmenity {
  unitId   Int
  optionId Int
  unit     Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  option   AmenityType @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([unitId, optionId])
  @@index([optionId])
}

model Tenant {
  id                  Int                   @id @default(autoincrement())
  organizationId      Int
  firstName           String
  lastName            String
  email               String                @unique
  phone               String?
  imageObjectKey      String?
  accountStatus       TenantAccountStatus   @default(invitation_pending)
  insuranceStatus     TenantInsuranceStatus @default(not_on_file)
  archivedAt          DateTime?
  legacyNotes         String?               @map("notes")
  legacyNoteId        Int?
  legacyNote          Note?                 @relation("TenantLegacyNote", fields: [id, legacyNoteId], references: [tenantId, id], onDelete: SetNull)
  emergencyContacts   EmergencyContact[]
  leases              Lease[]
  invoices            Invoice[]
  paymentsMade        Invoice[]             @relation("InvoicePaidByTenant")
  invoicePayments     InvoicePayment[]
  notes               Note[]
  maintenanceRequests MaintenanceTicket[]   @relation("MaintenanceRequesterTenant")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([id, legacyNoteId])
  @@index([organizationId])
}

model Landlord {
  id                  Int                 @id @default(autoincrement())
  organizationId      Int
  firstName           String
  lastName            String
  email               String              @unique
  phone               String?
  maintenanceRequests MaintenanceTicket[] @relation("MaintenanceRequesterLandlord")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model MaintenanceCategory {
  id        Int                 @id @default(autoincrement())
  organizationId Int
  label     String              @unique
  sortOrder Int                 @default(0)
  tickets   MaintenanceTicket[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model Note {
  id                  Int                @id @default(autoincrement())
  body                String
  propertyId          Int?
  unitId              Int?
  tenantId            Int?
  maintenanceTicketId Int?
  property            Property?          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit                Unit?              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant              Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maintenanceTicket   MaintenanceTicket? @relation(fields: [maintenanceTicketId], references: [id], onDelete: Cascade)
  legacyProperty      Property?          @relation("PropertyLegacyNote")
  legacyTenant        Tenant?            @relation("TenantLegacyNote")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([propertyId, id])
  @@unique([tenantId, id])
  @@index([propertyId, createdAt, id])
  @@index([unitId, createdAt, id])
  @@index([tenantId, createdAt, id])
  @@index([maintenanceTicketId, createdAt, id])
}

model EmergencyContact {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  firstName String
  lastName  String?
  phone     String?
  isPrimary Boolean  @default(false)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Lease {
  id                 Int         @id @default(autoincrement())
  organizationId     Int
  propertyId         Int
  tenantId           Int
  unitLabel          String
  monthlyRentCents   Int
  amountOverdueCents Int         @default(0)
  startsOn           DateTime
  endsOn             DateTime?
  status             LeaseStatus @default(draft)
  property           Property    @relation(fields: [propertyId], references: [id])
  tenant             Tenant      @relation(fields: [tenantId], references: [id])
  invoices           Invoice[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([propertyId])
  @@index([tenantId])
  @@unique([id, propertyId, tenantId])
  @@index([organizationId])
}

model Invoice {
  id             Int           @id @default(autoincrement())
  organizationId Int
  invoiceNumber  Int           @unique @default(autoincrement())
  leaseId        Int
  propertyId     Int
  tenantId       Int
  paidByTenantId Int?
  periodStartsOn DateTime
  periodEndsOn   DateTime
  dueOn          DateTime
  amountCents    Int
  balanceCents   Int
  status         InvoiceStatus @default(open)
  paidOn         DateTime?
  paymentMethod  String?
  items          InvoiceItem[]
  payments       InvoicePayment[]
  lease          Lease         @relation(fields: [leaseId, propertyId, tenantId], references: [id, propertyId, tenantId], onDelete: Cascade)
  property       Property      @relation(fields: [propertyId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  paidByTenant   Tenant?       @relation("InvoicePaidByTenant", fields: [paidByTenantId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([leaseId, periodStartsOn])
  @@unique([id, tenantId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([paidByTenantId])
  @@index([organizationId])
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  item        String
  description String?
  quantity    Int     @default(1)
  rateCents   Int
  amountCents Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
}

model InvoicePayment {
  id             Int      @id @default(autoincrement())
  invoiceId      Int
  tenantId       Int
  amountCents    Int
  paymentMethod  String
  paidOn         DateTime
  invoice        Invoice  @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  createdAt      DateTime @default(now())

  @@index([invoiceId, paidOn])
  @@index([tenantId])
}

model MaintenanceTicket {
  id                    Int                       @id @default(autoincrement())
  organizationId        Int
  ticketNumber          Int                       @unique @default(autoincrement())
  propertyId            Int
  unitLabel             String?
  title                 String
  description           String?
  status                MaintenanceTicketStatus   @default(new)
  priority              MaintenanceTicketPriority @default(medium)
  isUrgent              Boolean                   @default(false)
  consentToEnter        Boolean                   @default(false)
  categoryId            Int?
  requestedByType       MaintenanceRequesterType?
  requestedByTenantId   Int?
  requestedByLandlordId Int?
  openedOn              DateTime                  @default(now())
  dueOn                 DateTime?
  archivedAt            DateTime?
  property              Property                  @relation(fields: [propertyId], references: [id])
  category              MaintenanceCategory?      @relation(fields: [categoryId], references: [id])
  requestedByTenant     Tenant?                   @relation("MaintenanceRequesterTenant", fields: [requestedByTenantId], references: [id])
  requestedByLandlord   Landlord?                 @relation("MaintenanceRequesterLandlord", fields: [requestedByLandlordId], references: [id])
  units                 MaintenanceTicketUnit[]
  attachments           MaintenanceAttachment[]
  notes                 Note[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([propertyId])
  @@index([status])
  @@index([categoryId])
  @@index([requestedByTenantId])
  @@index([requestedByLandlordId])
  @@index([organizationId])
}

model ActivityEvent {
  id             Int                     @id @default(autoincrement())
  organizationId Int
  subjectType    ActivitySubjectType
  subjectId      Int
  subjectLabel   String
  subjectReference String?
  propertyId     Int?
  action         String
  previousStatus MaintenanceTicketStatus?
  nextStatus     MaintenanceTicketStatus?
  actorId        String?
  actorLabel     String?
  metadata       Json?
  property       Property?               @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt      DateTime                @default(now())
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([subjectType, subjectId, createdAt, id])
  @@index([propertyId, createdAt, id])
  @@index([action, createdAt])
  @@index([organizationId, createdAt])
}

model MaintenanceAttachment {
  id          Int               @id @default(autoincrement())
  ticketId    Int
  objectKey   String            @unique
  fileName    String
  contentType String
  ticket      MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([ticketId, createdAt])
}

model MaintenanceTicketUnit {
  ticketId Int
  unitId   Int
  ticket   MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  unit     Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([ticketId, unitId])
  @@index([unitId])
}
