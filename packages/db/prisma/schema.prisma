generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyStatus {
  active
  maintenance
  leasing
  archived
}

enum LeaseStatus {
  draft
  active
  notice
  ended
}

enum MaintenanceTicketStatus {
  open
  in_progress
  waiting_vendor
  resolved
}

enum MaintenanceTicketPriority {
  low
  medium
  high
  urgent
}

enum UnitType {
  residential
  commercial
}

enum TenantAccountStatus {
  activated
  invitation_pending
  disabled
}

enum TenantInsuranceStatus {
  active
  expired
  not_on_file
}

model Property {
  id                 Int                 @id @default(autoincrement())
  name               String
  line1              String
  line2              String?
  city               String
  region             String
  postalCode         String
  propertyType       String              @default("Apartment")
  imageObjectKey     String?
  tags               Tag[]
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  contactAddress     String?
  legacyNotes        String?             @map("notes")
  unitCount          Int
  occupiedUnits      Int                 @default(0)
  status             PropertyStatus      @default(active)
  units              Unit[]
  leases             Lease[]
  notes              Note[]
  maintenanceTickets MaintenanceTicket[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Tag {
  id        Int        @id @default(autoincrement())
  label     String     @unique
  sortOrder Int        @default(0)
  properties Property[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Unit {
  id              Int               @id @default(autoincrement())
  propertyId      Int
  name            String
  marketRateCents Int
  unitType        UnitType          @default(residential)
  bedrooms        Int?
  bathrooms       Decimal?          @db.Decimal(4, 1)
  squareFeet      Int?
  property        Property          @relation(fields: [propertyId], references: [id])
  utilities       UnitUtility[]
  amenities       UnitAmenity[]
  notes           Note[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([propertyId, name])
  @@index([propertyId])
}

model UtilityType {
  id        Int           @id @default(autoincrement())
  label     String        @unique
  sortOrder Int           @default(0)
  units     UnitUtility[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model AmenityType {
  id        Int           @id @default(autoincrement())
  label     String        @unique
  sortOrder Int           @default(0)
  units     UnitAmenity[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model UnitUtility {
  unitId   Int
  optionId Int
  unit     Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  option   UtilityType @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([unitId, optionId])
  @@index([optionId])
}

model UnitAmenity {
  unitId   Int
  optionId Int
  unit     Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  option   AmenityType @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([unitId, optionId])
  @@index([optionId])
}

model Tenant {
  id              Int                   @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String                @unique
  phone           String?
  imageObjectKey  String?
  accountStatus   TenantAccountStatus   @default(invitation_pending)
  insuranceStatus TenantInsuranceStatus @default(not_on_file)
  archivedAt      DateTime?
  legacyNotes     String?                 @map("notes")
  emergencyContacts EmergencyContact[]
  leases          Lease[]
  notes           Note[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model Note {
  id         Int       @id @default(autoincrement())
  body       String
  propertyId Int?
  unitId     Int?
  tenantId   Int?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit       Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([propertyId, createdAt, id])
  @@index([unitId, createdAt, id])
  @@index([tenantId, createdAt, id])
}

model EmergencyContact {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  firstName String
  lastName  String?
  phone     String?
  isPrimary Boolean  @default(false)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Lease {
  id                 Int         @id @default(autoincrement())
  propertyId         Int
  tenantId           Int
  unitLabel          String
  monthlyRentCents   Int
  amountOverdueCents Int         @default(0)
  startsOn           DateTime
  endsOn             DateTime?
  status             LeaseStatus @default(draft)
  property           Property    @relation(fields: [propertyId], references: [id])
  tenant             Tenant      @relation(fields: [tenantId], references: [id])
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([propertyId])
  @@index([tenantId])
}

model MaintenanceTicket {
  id          Int                       @id @default(autoincrement())
  propertyId  Int
  unitLabel   String?
  title       String
  description String?
  status      MaintenanceTicketStatus   @default(open)
  priority    MaintenanceTicketPriority @default(medium)
  openedOn    DateTime                  @default(now())
  dueOn       DateTime?
  property    Property                  @relation(fields: [propertyId], references: [id])
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([propertyId])
  @@index([status])
}
