generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PropertyStatus {
  active
  maintenance
  leasing
  archived
}

enum LeaseStatus {
  draft
  active
  notice
  ended
}

enum InvoiceStatus {
  open
  overdue
  paid
  void
}

enum MaintenanceTicketStatus {
  new
  in_progress
  pending
  scheduled
  resolved
  closed
  canceled
}

enum MaintenanceTicketPriority {
  low
  medium
  high
  urgent
}

enum MaintenanceRequesterType {
  tenant
  landlord
}

enum ActivitySubjectType {
  maintenance_ticket
  tenant
  property
  invoice
}

enum UnitType {
  residential
  commercial
}

enum TenantAccountStatus {
  activated
  invitation_pending
  disabled
}

enum TenantInsuranceStatus {
  active
  expired
  not_on_file
}

enum UserRole {
  administrator
  member
}

enum UserAccountStatus {
  active
  disabled
}

enum OrganizationMemberRole {
  owner
  administrator
  member
}

model Organization {
  id                    Int                      @id @default(autoincrement())
  name                  String
  slug                  String                   @unique
  seedKey               String?                  @unique
  avatarObjectKey       String?
  darkAvatarObjectKey   String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  region                String?
  postalCode            String?
  phone                 String?
  memberships           OrganizationMembership[]
  properties            Property[]
  tenants               Tenant[]
  landlords             Landlord[]
  tags                  Tag[]
  utilityTypes          UtilityType[]
  amenityTypes          AmenityType[]
  maintenanceCategories MaintenanceCategory[]
  applicationStatuses   ApplicationStatus[]
  applicants            Applicant[]
  applications          Application[]
  leases                Lease[]
  invoices              Invoice[]
  maintenanceTickets    MaintenanceTicket[]
  activityEvents        ActivityEvent[]
  defaultUsers          User[]                   @relation("UserDefaultOrganization")
  activeSessions        Session[]                @relation("SessionActiveOrganization")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
}

model OrganizationMembership {
  id             Int                    @id @default(autoincrement())
  userId         Int
  organizationId Int
  role           OrganizationMemberRole @default(member)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model User {
  id                      Int                      @id @default(autoincrement())
  name                    String                   @default("User")
  email                   String                   @unique
  phone                   String?
  role                    UserRole                 @default(member)
  accountStatus           UserAccountStatus        @default(active)
  passwordHash            String
  defaultOrganizationId   Int?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sessions                Session[]
  organizationMemberships OrganizationMembership[]
  defaultOrganization     Organization?            @relation("UserDefaultOrganization", fields: [defaultOrganizationId], references: [id], onDelete: SetNull)

  @@index([defaultOrganizationId])
}

model Session {
  id                   Int           @id @default(autoincrement())
  userId               Int
  tokenHash            String        @unique
  expiresAt            DateTime
  revokedAt            DateTime?
  createdAt            DateTime      @default(now())
  lastSeenAt           DateTime      @default(now())
  activeOrganizationId Int?
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation("SessionActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganizationId])
  @@index([expiresAt])
}

model Property {
  id                 Int                 @id @default(autoincrement())
  organizationId     Int
  name               String
  line1              String
  line2              String?
  city               String
  region             String
  postalCode         String
  propertyType       String              @default("Apartment")
  imageObjectKey     String?
  tags               Tag[]
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  contactAddress     String?
  legacyNotes        String?             @map("notes")
  legacyNoteId       Int?
  legacyNote         Note?               @relation("PropertyLegacyNote", fields: [id, legacyNoteId], references: [propertyId, id], onDelete: SetNull)
  unitCount          Int
  occupiedUnits      Int                 @default(0)
  status             PropertyStatus      @default(active)
  units              Unit[]
  leases             Lease[]             @relation("LeaseProperty")
  invoices           Invoice[]           @relation("InvoiceProperty")
  notes              Note[]
  maintenanceTickets MaintenanceTicket[]
  activityEvents     ActivityEvent[]
  applications       Application[]
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([id, legacyNoteId])
  @@unique([organizationId, id])
  @@index([organizationId])
}

model Tag {
  id             Int          @id @default(autoincrement())
  organizationId Int
  label          String
  sortOrder      Int          @default(0)
  properties     Property[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, label])
  @@index([organizationId])
}

model Unit {
  id                 Int                     @id @default(autoincrement())
  propertyId         Int
  name               String
  marketRateCents    Int
  unitType           UnitType                @default(residential)
  bedrooms           Int?
  bathrooms          Decimal?                @db.Decimal(4, 1)
  squareFeet         Int?
  property           Property                @relation(fields: [propertyId], references: [id])
  utilities          UnitUtility[]
  amenities          UnitAmenity[]
  notes              Note[]
  maintenanceTickets MaintenanceTicketUnit[]
  leases             Lease[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([propertyId, name])
  @@unique([propertyId, id])
  @@index([propertyId])
}

model UtilityType {
  id             Int           @id @default(autoincrement())
  organizationId Int
  label          String
  sortOrder      Int           @default(0)
  units          UnitUtility[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, label])
  @@index([organizationId])
}

model AmenityType {
  id             Int           @id @default(autoincrement())
  organizationId Int
  label          String
  sortOrder      Int           @default(0)
  units          UnitAmenity[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, label])
  @@index([organizationId])
}

model UnitUtility {
  unitId   Int
  optionId Int
  unit     Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  option   UtilityType @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([unitId, optionId])
  @@index([optionId])
}

model UnitAmenity {
  unitId   Int
  optionId Int
  unit     Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  option   AmenityType @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([unitId, optionId])
  @@index([optionId])
}

model Tenant {
  id                  Int                   @id @default(autoincrement())
  organizationId      Int
  firstName           String
  lastName            String
  email               String
  phone               String?
  imageObjectKey      String?
  accountStatus       TenantAccountStatus   @default(invitation_pending)
  insuranceStatus     TenantInsuranceStatus @default(not_on_file)
  archivedAt          DateTime?
  legacyNotes         String?               @map("notes")
  legacyNoteId        Int?
  legacyNote          Note?                 @relation("TenantLegacyNote", fields: [id, legacyNoteId], references: [tenantId, id], onDelete: SetNull)
  emergencyContacts   EmergencyContact[]
  leases              LeaseTenant[]         @relation("LeaseTenant")
  invoices            Invoice[]             @relation("InvoiceTenant")
  paymentsMade        Invoice[]             @relation("InvoicePaidByTenant")
  invoicePayments     InvoicePayment[]
  notes               Note[]
  maintenanceRequests MaintenanceTicket[]   @relation("MaintenanceRequesterTenant")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([id, legacyNoteId])
  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@index([organizationId])
}

model Landlord {
  id                  Int                 @id @default(autoincrement())
  organizationId      Int
  firstName           String
  lastName            String
  email               String
  phone               String?
  maintenanceRequests MaintenanceTicket[] @relation("MaintenanceRequesterLandlord")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@index([organizationId])
}

model MaintenanceCategory {
  id             Int                 @id @default(autoincrement())
  organizationId Int
  label          String
  sortOrder      Int                 @default(0)
  tickets        MaintenanceTicket[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, label])
  @@index([organizationId])
}

model ApplicationStatus {
  id             Int           @id @default(autoincrement())
  organizationId Int
  label          String
  sortOrder      Int           @default(0)
  isActive       Boolean       @default(true)
  applications   Application[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, label])
  @@index([organizationId])
}

model Applicant {
  id             Int           @id @default(autoincrement())
  organizationId Int
  firstName      String
  lastName       String
  email          String
  phone          String?
  dateOfBirth    DateTime?
  employment     String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  applications   Application[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, email])
}

model Application {
  id                  Int               @id @default(autoincrement())
  organizationId      Int
  propertyId          Int
  applicantId         Int
  statusId            Int
  annualIncomeCents   Int
  submittedOn         DateTime          @default(now())
  requestedMoveInDate DateTime? @db.Date
  archivedAt          DateTime?
  property            Property          @relation(fields: [organizationId, propertyId], references: [organizationId, id])
  applicant           Applicant         @relation(fields: [organizationId, applicantId], references: [organizationId, id])
  status              ApplicationStatus @relation(fields: [organizationId, statusId], references: [organizationId, id], onDelete: Restrict)
  notes               Note[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([propertyId])
  @@index([applicantId])
  @@index([statusId])
  @@index([organizationId])
}

model Note {
  id                  Int                @id @default(autoincrement())
  body                String
  propertyId          Int?
  unitId              Int?
  tenantId            Int?
  maintenanceTicketId Int?
  applicationId       Int?
  property            Property?          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit                Unit?              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant              Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maintenanceTicket   MaintenanceTicket? @relation(fields: [maintenanceTicketId], references: [id], onDelete: Cascade)
  application         Application?       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  legacyProperty      Property?          @relation("PropertyLegacyNote")
  legacyTenant        Tenant?            @relation("TenantLegacyNote")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([propertyId, id])
  @@unique([tenantId, id])
  @@index([propertyId, createdAt, id])
  @@index([unitId, createdAt, id])
  @@index([tenantId, createdAt, id])
  @@index([maintenanceTicketId, createdAt, id])
  @@index([applicationId, createdAt, id])
}

model EmergencyContact {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  firstName String
  lastName  String?
  phone     String?
  isPrimary Boolean  @default(false)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Lease {
  id               Int          @id @default(autoincrement())
  organizationId   Int
  propertyId       Int
  unitId           Int
  monthlyRentCents Int
  startsOn         DateTime
  endsOn           DateTime?
  status           LeaseStatus  @default(draft)
  property         Property     @relation("LeaseProperty", fields: [organizationId, propertyId], references: [organizationId, id])
  unit             Unit         @relation(fields: [propertyId, unitId], references: [propertyId, id])
  tenants          LeaseTenant[]
  invoices         Invoice[]    @relation("InvoiceLease")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([propertyId])
  @@index([unitId])
  @@index([organizationId])
  @@unique([organizationId, id])
  @@unique([organizationId, id, propertyId])
}

model LeaseTenant {
  organizationId Int
  leaseId        Int
  tenantId       Int
  lease          Lease     @relation(fields: [organizationId, leaseId], references: [organizationId, id], onDelete: Cascade)
  tenant         Tenant    @relation("LeaseTenant", fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Cascade)
  invoices       Invoice[] @relation("InvoiceLeaseTenant")
  createdAt      DateTime  @default(now())

  @@id([organizationId, leaseId, tenantId])
  @@index([tenantId])
}

model Invoice {
  id             Int              @id @default(autoincrement())
  organizationId Int
  invoiceNumber  Int              @unique @default(autoincrement())
  leaseId        Int
  propertyId     Int
  tenantId       Int
  paidByTenantId Int?
  periodStartsOn DateTime
  periodEndsOn   DateTime
  dueOn          DateTime
  amountCents    Int
  balanceCents   Int
  status         InvoiceStatus    @default(open)
  paidOn         DateTime?
  paymentMethod  String?
  items          InvoiceItem[]
  payments       InvoicePayment[]   @relation("InvoicePaymentInvoice")
  lease          Lease              @relation("InvoiceLease", fields: [organizationId, leaseId, propertyId], references: [organizationId, id, propertyId], onDelete: Cascade)
  property       Property           @relation("InvoiceProperty", fields: [organizationId, propertyId], references: [organizationId, id])
  tenant         Tenant             @relation("InvoiceTenant", fields: [organizationId, tenantId], references: [organizationId, id])
  paidByTenant   Tenant?            @relation("InvoicePaidByTenant", fields: [organizationId, paidByTenantId], references: [organizationId, id], onDelete: SetNull)
  leaseTenant    LeaseTenant        @relation("InvoiceLeaseTenant", fields: [organizationId, leaseId, tenantId], references: [organizationId, leaseId, tenantId], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([leaseId, tenantId, periodStartsOn])
  @@unique([id, tenantId])
  @@index([leaseId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([paidByTenantId])
  @@index([organizationId])
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  item        String
  description String?
  quantity    Int      @default(1)
  rateCents   Int
  amountCents Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
}

model InvoicePayment {
  id            Int      @id @default(autoincrement())
  invoiceId     Int
  tenantId      Int
  amountCents   Int
  paymentMethod String
  paidOn        DateTime
  invoice       Invoice  @relation("InvoicePaymentInvoice", fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  createdAt     DateTime @default(now())

  @@index([invoiceId, paidOn])
  @@index([tenantId])
}

model MaintenanceTicket {
  id                    Int                       @id @default(autoincrement())
  organizationId        Int
  ticketNumber          Int                       @unique @default(autoincrement())
  propertyId            Int
  unitLabel             String?
  title                 String
  description           String?
  status                MaintenanceTicketStatus   @default(new)
  priority              MaintenanceTicketPriority @default(medium)
  isUrgent              Boolean                   @default(false)
  consentToEnter        Boolean                   @default(false)
  categoryId            Int?
  requestedByType       MaintenanceRequesterType?
  requestedByTenantId   Int?
  requestedByLandlordId Int?
  openedOn              DateTime                  @default(now())
  dueOn                 DateTime?
  archivedAt            DateTime?
  property              Property                  @relation(fields: [organizationId, propertyId], references: [organizationId, id])
  category              MaintenanceCategory?      @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: SetNull)
  requestedByTenant     Tenant?                   @relation("MaintenanceRequesterTenant", fields: [organizationId, requestedByTenantId], references: [organizationId, id], onDelete: Restrict)
  requestedByLandlord   Landlord?                 @relation("MaintenanceRequesterLandlord", fields: [organizationId, requestedByLandlordId], references: [organizationId, id], onDelete: Restrict)
  units                 MaintenanceTicketUnit[]
  attachments           MaintenanceAttachment[]
  notes                 Note[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([propertyId])
  @@index([status])
  @@index([categoryId])
  @@index([requestedByTenantId])
  @@index([requestedByLandlordId])
  @@index([organizationId])
}

model ActivityEvent {
  id               Int                      @id @default(autoincrement())
  organizationId   Int
  subjectType      ActivitySubjectType
  subjectId        Int
  subjectLabel     String
  subjectReference String?
  propertyId       Int?
  action           String
  previousStatus   MaintenanceTicketStatus?
  nextStatus       MaintenanceTicketStatus?
  actorId          String?
  actorLabel       String?
  metadata         Json?
  property         Property?                @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: SetNull)
  createdAt        DateTime                 @default(now())
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([subjectType, subjectId, createdAt, id])
  @@index([propertyId, createdAt, id])
  @@index([action, createdAt])
  @@index([organizationId, createdAt])
}

model MaintenanceAttachment {
  id          Int               @id @default(autoincrement())
  ticketId    Int
  objectKey   String            @unique
  fileName    String
  contentType String
  ticket      MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([ticketId, createdAt])
}

model MaintenanceTicketUnit {
  ticketId Int
  unitId   Int
  ticket   MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  unit     Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([ticketId, unitId])
  @@index([unitId])
}
