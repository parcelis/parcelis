{
  "name": "@parcelis/jobs",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:fixed": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:notification": "tsx --test src/notification-jobs.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bullmq": "^6.3.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@parcelis/config": "workspace:*",
    "@types/node": "24.19.1",
    "tsx": "^4.23.12",
    "typescript": "6.0.3"
  }
}
