{
  "name": "parcelis",
  "private": true,
  "version": "0.4.1",
  "description": "Open-source property management platform for boutique operators.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "node scripts/dev-local.mjs",
    "dev:services:refresh": "node scripts/refresh-dev-services.mjs",
    "dev:turbo": "turbo dev --parallel",
    "postinstall": "pnpm db:generate",
    "lint": "turbo lint",
    "lint:commits": "commitlint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @parcelis/db db:generate",
    "db:migrate": "pnpm --filter @parcelis/db db:migrate",
    "db:seed": "pnpm --filter @parcelis/db db:seed",
    "email:verify": "pnpm --filter @parcelis/email build && node --env-file=.env packages/email/dist/verify.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@parcelis/config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "6.0.3"
  },
  "volta": {
    "node": "24.19.0"
  }
}
