# Database Configuration
DATABASE_URL="postgresql://parcelis:parcelis@localhost:54320/parcelis?schema=public"
POSTGRES_DB=parcelis
POSTGRES_USER=parcelis
POSTGRES_PASSWORD=parcelis
POSTGRES_PORT="54320"
PGADMIN_PORT="8000"
PGADMIN_DEFAULT_EMAIL="admin@parcelis.dev"
PGADMIN_DEFAULT_PASSWORD="parcelis"

# Object Storage Configuration
MINIO_ROOT_USER=parcelis-minio
MINIO_ROOT_PASSWORD=parcelis-minio
MINIO_ASSETS_BUCKET=parcelis-assets
MINIO_API_PORT="9001"
MINIO_CONSOLE_PORT="9010"
MINIO_BUCKET="parcelis-images"
S3_BUCKET="parcelis-images"
S3_PUBLIC_ENDPOINT="http://localhost:9001"
S3_ENDPOINT="http://localhost:9001"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="parcelis-minio"
S3_SECRET_ACCESS_KEY="parcelis-minio"
NEXT_PUBLIC_S3_URL="http://localhost:9001"

# Published image version
PARCELIS_VERSION="v0.3.0"

# Application Configuration
WEB_ORIGIN="https://parcelis.example.com"
WEB_PORT=3000
DOCS_PORT=8080

# Authentication Configuration
